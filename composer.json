{
    "name": "webcommander/webcommander",
    "description": "PHP SDK for the WebCommander v4 REST API.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/WebCommanderCMS/webcommander-sdk-php",
    "authors": [
        {
            "name": "WebCommander"
        }
    ],
    "support": {
        "source": "https://github.com/WebCommanderCMS/webcommander-sdk-php",
        "issues": "https://github.com/WebCommanderCMS/webcommander-sdk-php/issues"
    },
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "WebCommander\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebCommander\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/src/",
            "!/composer.json",
            "!/LICENSE",
            "!/README.md",
            "*.log",
            "TEST*.xml",
            ".DS_Store",
            "Thumbs.db"
        ]
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "scripts-descriptions": {
        "test": "Run the live PHPUnit suite against the configured store."
    }
}
